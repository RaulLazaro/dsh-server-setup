# DSH Server Configuration
# Copy this file to .env next to run.sh and edit it — run.sh sources it.
# systemd reads the unit's own Environment= lines, not this file.

# DSH listen port (loopback only; the proxy plugin serves the LAN/public port)
DSH_PORT=3079

# DSH home directory
DSH_HOME=/home/YOUR_USER/.dsh

# Public hostname this instance should trust, so it can be opened without a
# token in the URL. Leave empty to disable.
DSH_TRUSTED_HOST=dsh.example.com

# Proxy settings are NOT environment variables: configure them from
# Settings → LAN Proxy or from cordis.patch.yml in the web profile.

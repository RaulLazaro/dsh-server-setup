[Unit]
Description=DSH (DeepSeek Harness) Web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Edit these four placeholders before installing the unit.
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/path/to/dsh-server-setup
ExecStart=/path/to/dsh-server-setup/run.sh
# Re-applies the local node_modules workarounds on every boot (npm rewrites the
# global tree on each install, so this cannot be a one-time manual step).
# See README "Local patches (ExecStartPre)".
ExecStartPre=/path/to/dsh-server-setup/scripts/patch-dsh-connection.sh
Restart=always
RestartSec=5
# The reverse proxy is a DSH plugin, so there is nothing else to supervise here.
# Per-instance defaults can also live in /path/to/dsh-server-setup/.env, which
# run.sh sources; these Environment= lines win over it.
Environment=DSH_HOME=/home/YOUR_USER/.dsh
Environment=DSH_PORT=3079
# Environment=DSH_TRUSTED_HOST=dsh.example.com

[Install]
WantedBy=multi-user.target

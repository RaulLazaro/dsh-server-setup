[Unit]
Description=DSH (DeepSeek Harness) Web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/dsh-server-setup
ExecStart=/home/ubuntu/dsh-server-setup/run.sh
Restart=always
RestartSec=5
Environment=DSH_HOME=/home/ubuntu/.dsh
Environment=DSH_PORT=3079

[Install]
WantedBy=multi-user.target
